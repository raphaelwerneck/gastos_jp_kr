[client]
toolbarMode = "minimal"


[server]
headless = true
enableCORS = false
enableXsrfProtection = true

[browser]
gatherUsageStats = false

[theme]
base = "dark" 
primaryColor = "#6C63FF"
backgroundColor = "#0E1117"
secondaryBackgroundColor = "#161B26"
textColor = "#E6E9F0"
font = "Inter:https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"

baseRadius = "0.65rem"
buttonRadius = "0.65rem"
borderColor = "#263041"
showWidgetBorder = true
showSidebarBorder = false

chartCategoricalColors = [
    "#6C63FF",
    "#4DABF7",
    "#51CF66",
    "#FFA94D",
    "#FF6B6B",
    "#22D3EE",
    "#F783AC",
    "#FCC419",
]

chartSequentialColors = [
    "#0B132B",
    "#14213D",
    "#1C2541",
    "#23395B",
    "#2C4A6E",
    "#3A506B",
    "#4E6E81",
    "#5BC0BE",
    "#6C63FF",
    "#9775FA",
]
